{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!dist", "!node_modules", "!package-lock.json", "!module.json"]
  },
  "assist": { "enabled": false },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": true
    },
    "globals": [
      "game",
      "ui",
      "canvas",
      "Hooks",
      "CONFIG",
      "CONST",
      "foundry",
      "dnd5e",
      "Actor",
      "Item",
      "ActiveEffect",
      "ChatMessage",
      "Combat",
      "Combatant",
      "Token",
      "TokenDocument",
      "Scene",
      "fromUuid",
      "fromUuidSync"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": { "level": "warn", "options": { "allow": ["warn", "error"] } },
        "noExplicitAny": "off",
        "noAssignInExpressions": "warn",
        "useIterableCallbackReturn": "warn"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUndeclaredVariables": "error",
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "warn"
      },
      "nursery": { "noFloatingPromises": "error" },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "off",
        "useTemplate": "off"
      },
      "complexity": { "useOptionalChain": "warn" }
    }
  },
  "overrides": [
    {
      "includes": ["tools/**"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off", "noAssignInExpressions": "off" },
          "nursery": { "noFloatingPromises": "off" }
        }
      }
    }
  ]
}
